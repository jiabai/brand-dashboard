{
  "openapi": "3.0.0",
  "info": {
    "title": "Brand Dashboard - Executors API",
    "description": "执行器管理接口，支持执行器的预设、自动注册和生命周期管理。",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/executors/": {
      "post": {
        "summary": "预设执行器 (Admin: Create)",
        "description": "管理员手动创建一个新的执行器记录，并预设其允许的 IP 地址。响应中不包含 api_key，执行器需通过 /register 接口取回。",
        "operationId": "create_executor",
        "tags": ["Executors"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExecutorCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "获取执行器列表 (Admin: List)",
        "description": "获取系统中所有已预设的执行器列表，包含 IP 地址和状态，但不返回敏感的 api_key。",
        "operationId": "list_executors",
        "tags": ["Executors"],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExecutorListItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/executors/register": {
      "post": {
        "summary": "执行器注册 (Executor: Register)",
        "description": "执行器从预设的 IP 地址发起请求。系统根据请求来源 IP 自动识别执行器身份，并返回其专属的 executor_id 和 api_key。",
        "operationId": "register_executor",
        "tags": ["Executors"],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutorRegistrationResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - IP not authorized"
          }
        }
      }
    },
    "/api/v1/executors/{executor_id}": {
      "delete": {
        "summary": "禁用执行器 (Admin: Deactivate)",
        "description": "将指定执行器的状态设置为 inactive，禁止其后续的所有业务请求。",
        "operationId": "deactivate_executor",
        "tags": ["Executors"],
        "parameters": [
          {
            "name": "executor_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "要禁用的执行器唯一标识符"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ExecutorBase": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "执行器名称",
            "example": "香港机房-爬虫01"
          },
          "type": {
            "type": "string",
            "description": "执行器类型",
            "example": "crawler",
            "nullable": true
          },
          "ip_address": {
            "type": "string",
            "description": "执行器允许的 IP 地址",
            "example": "47.91.22.33"
          }
        },
        "required": ["name", "ip_address"]
      },
      "ExecutorCreate": {
        "allOf": [
          { "$ref": "#/components/schemas/ExecutorBase" }
        ]
      },
      "ExecutorResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/ExecutorBase" },
          {
            "type": "object",
            "properties": {
              "executor_id": {
                "type": "string",
                "description": "执行器唯一标识符"
              },
              "status": {
                "type": "string",
                "description": "执行器状态"
              },
              "created_at": {
                "type": "string",
                "format": "date-time",
                "description": "创建时间"
              }
            },
            "required": ["executor_id", "status", "created_at"]
          }
        ]
      },
      "ExecutorListItem": {
        "allOf": [
          { "$ref": "#/components/schemas/ExecutorBase" },
          {
            "type": "object",
            "properties": {
              "executor_id": {
                "type": "string",
                "description": "执行器唯一标识符"
              },
              "status": {
                "type": "string",
                "description": "执行器状态"
              },
              "created_at": {
                "type": "string",
                "format": "date-time",
                "description": "创建时间"
              }
            },
            "required": ["executor_id", "status", "created_at"]
          }
        ]
      },
      "ExecutorRegistrationResponse": {
        "type": "object",
        "properties": {
          "executor_id": {
            "type": "string",
            "description": "分发的执行器唯一标识符"
          },
          "api_key": {
            "type": "string",
            "description": "分发的执行器 API Key"
          }
        },
        "required": ["executor_id", "api_key"]
      }
    }
  }
}
