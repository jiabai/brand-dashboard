{
  "openapi": "3.0.0",
  "info": {
    "title": "Brand Dashboard API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/dashboard/platform-metrics-by-brand": {
      "get": {
        "summary": "获取品牌平台指标",
        "description": "获取品牌总指标，基于`qa_brand_state`表计算",
        "operationId": "get_platform_metrics_by_brand",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "description": "用户ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "job_id",
            "in": "query",
            "description": "任务ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "brand",
            "in": "query",
            "description": "品牌名称",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "timeframe",
            "in": "query",
            "description": "时间范围，可选值: `yesterday`, `7days`, `30days`",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "yesterday",
                "7days",
                "30days"
              ]
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "具体日期(格式: YYYYMMDD)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformMetricsByBrandResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PlatformMetricsByBrandResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "响应状态"
          },
          "data": {
            "$ref": "#/components/schemas/PlatformMetricsByBrandData"
          },
          "metadata": {
            "$ref": "#/components/schemas/PlatformMetricsByBrandMetadata"
          }
        },
        "required": [
          "status",
          "data",
          "metadata"
        ]
      },
      "PlatformMetricsByBrandData": {
        "type": "object",
        "properties": {
          "brand": {
            "type": "string",
            "description": "品牌名称"
          },
          "platforms": {
            "type": "array",
            "description": "平台指标列表",
            "items": {
              "$ref": "#/components/schemas/PlatformMetricsByBrandItem"
            }
          }
        },
        "required": [
          "brand",
          "platforms"
        ]
      },
      "PlatformMetricsByBrandItem": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "description": "平台名称"
          },
          "mention_rate": {
            "type": "number",
            "description": "平台提及率"
          }
        },
        "required": [
          "platform",
          "mention_rate"
        ]
      },
      "PlatformMetricsByBrandMetadata": {
        "type": "object",
        "properties": {
          "timeframe": {
            "type": "string",
            "description": "时间范围"
          },
          "calculation_method": {
            "type": "string",
            "description": "计算方法"
          }
        },
        "required": [
          "timeframe",
          "calculation_method"
        ]
      }
    }
  }
}

