            "description": "问题生效状态"
          },
          "effective_from": {
            "type": "string",
            "format": "date-time",
            "title": "Effective From",
            "description": "生效开始时间"
          },
          "effective_to": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
