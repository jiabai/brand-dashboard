            "type": "string",
            "title": "Tenant Key",
            "description": "租户Key"
          },
          "brand": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand",
            "description": "品牌"
          },
          "competitor": {
