{
  "openapi": "3.1.0",
  "info": {
    "title": "Brand Dashboard API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/query-jobs/fetch": {
      "get": {
        "tags": [
          "query-jobs"
        ],
        "summary": "Fetch Query Job",
        "description": "执行器获取待执行任务。\n采用 Round-Robin 策略：优先选取已执行次数最少的任务，且按物理顺序排列。",
        "operationId": "fetch_query_job_api_v1_query_jobs_fetch_get",
        "parameters": [
          {
            "name": "tenant_key",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "可选：仅拉取指定租户的任务",
              "title": "Tenant Key"
            },
            "description": "可选：仅拉取指定租户的任务"
          },
          {
            "name": "job_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "可选：仅拉取指定 job_id 的任务",
              "title": "Job Id"
            },
            "description": "可选：仅拉取指定 job_id 的任务"
          },
          {
            "name": "executor_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "执行器唯一ID",
              "title": "Executor Id"
            },
            "description": "执行器唯一ID"
          },
          {
            "name": "X-Executor-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Executor-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FetchQueryJobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/query-jobs/report": {
      "post": {
        "tags": [
          "query-jobs"
        ],
        "summary": "Report Query Job",
        "description": "执行器上报任务执行结果。\n仅更新 llm_query_jobs 表中的执行次数和日期。",
        "operationId": "report_query_job_api_v1_query_jobs_report_post",
        "parameters": [
          {
            "name": "executor_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "执行器唯一ID",
              "title": "Executor Id"
            },
            "description": "执行器唯一ID"
          },
          {
            "name": "X-Executor-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Executor-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Body_report_query_job_api_v1_query_jobs_report_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportQueryJobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/query-jobs/status": {
      "get": {
        "tags": [
          "query-jobs"
        ],
        "summary": "List Query Jobs Status",
        "operationId": "list_query_jobs_status_api_v1_query_jobs_status_get",
        "parameters": [
          {
            "name": "tenant_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "租户Key",
              "title": "Tenant Key"
            },
            "description": "租户Key"
          },
          {
            "name": "job_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "可选：仅查询指定 job_id 的任务",
              "title": "Job Id"
            },
            "description": "可选：仅查询指定 job_id 的任务"
          },
          {
            "name": "include_deleted",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "是否包含已删除任务",
              "default": false,
              "title": "Include Deleted"
            },
            "description": "是否包含已删除任务"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryJobStatusResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/query-jobs/load": {
      "post": {
        "tags": [
          "query-jobs"
        ],
        "summary": "Load Query Jobs",
        "description": "接收原始JSON数据并加载到llm_query_jobs数据库表中.",
        "operationId": "load_query_jobs_api_v1_query_jobs_load_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoadQueryJobsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoadQueryJobsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_report_query_job_api_v1_query_jobs_report_post": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "任务记录唯一主键ID"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "Body_report_query_job_api_v1_query_jobs_report_post"
      },
      "FetchQueryJobResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "是否成功"
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "description": "任务数量"
          },
          "jobs": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/QueryJobDetail"
              },
              {
                "type": "null"
              }
            ],
            "description": "任务详情"
          }
        },
        "type": "object",
        "required": [
          "success",
          "count"
        ],
        "title": "FetchQueryJobResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoadQueryJobsRequest": {
        "properties": {
          "tenant_key": {
            "type": "string",
            "minLength": 1,
            "title": "Tenant Key",
            "description": "租户Key"
          },
          "job_id": {
            "type": "string",
            "minLength": 1,
            "title": "Job Id",
            "description": "任务ID"
          },
          "effective_from": {
            "type": "string",
            "format": "date-time",
            "title": "Effective From",
            "description": "生效开始时间"
          },
          "effective_to": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective To",
            "description": "生效结束时间（NULL表示未结束）"
          },
          "executor_id": {
            "type": "string",
            "minLength": 1,
            "title": "Executor Id",
            "description": "执行器ID"
          },
          "total_runs": {
            "type": "integer",
            "title": "Total Runs",
            "description": "总执行次数",
            "default": 15
          },
          "executed_runs": {
            "type": "integer",
            "title": "Executed Runs",
            "description": "已执行次数",
            "default": 0
          },
          "last_executed_date": {
            "type": "string",
            "format": "date",
            "title": "Last Executed Date",
            "description": "最近执行日期"
          },
          "data": {
            "$ref": "#/components/schemas/QueryJobData",
            "description": "要加载的查询任务JSON数据"
          }
        },
        "type": "object",
        "required": [
          "tenant_key",
          "job_id",
          "effective_from",
          "executor_id",
          "data"
        ],
        "title": "LoadQueryJobsRequest"
      },
      "LoadQueryJobsResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "是否成功"
          },
          "inserted_rows": {
            "type": "integer",
            "title": "Inserted Rows",
            "description": "插入行数"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "响应消息"
          }
        },
        "type": "object",
        "required": [
          "success",
          "inserted_rows",
          "message"
        ],
        "title": "LoadQueryJobsResponse"
      },
      "QueryContentItem": {
        "properties": {
          "keyword": {
            "type": "string",
            "minLength": 1,
            "title": "Keyword",
            "description": "关键词"
          },
          "query_content": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Query Content",
            "description": "查询内容列表"
          }
        },
        "type": "object",
        "required": [
          "keyword",
          "query_content"
        ],
        "title": "QueryContentItem"
      },
      "QueryJobData": {
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1,
            "title": "Category",
            "description": "分类"
          },
          "brand": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand",
            "description": "品牌"
          },
          "competitor": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Competitor",
            "description": "竞品列表"
          },
          "content": {
            "items": {
              "$ref": "#/components/schemas/QueryContentItem"
            },
            "type": "array",
            "minItems": 1,
            "title": "Content",
            "description": "内容列表"
          }
        },
        "type": "object",
        "required": [
          "category",
          "content"
        ],
        "title": "QueryJobData"
      },
      "QueryJobDetail": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "任务记录唯一主键ID"
          },
          "job_id": {
            "type": "string",
            "title": "Job Id",
            "description": "任务组ID"
          },
          "tenant_key": {
            "type": "string",
            "title": "Tenant Key",
            "description": "租户Key"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "description": "分类"
          },
          "brand": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand",
            "description": "品牌"
          },
          "competitor": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Competitor",
            "description": "竞品列表"
          },
          "keyword": {
            "type": "string",
            "title": "Keyword",
            "description": "关键词"
          },
          "query_content": {
            "type": "string",
            "title": "Query Content",
            "description": "查询内容"
          }
        },
        "type": "object",
        "required": [
          "id",
          "job_id",
          "tenant_key",
          "category",
          "keyword",
          "query_content"
        ],
        "title": "QueryJobDetail"
      },
      "QueryJobStatusItem": {
