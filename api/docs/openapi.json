        "properties": {
          "brand": {
            "type": "string",
            "title": "Brand",
            "description": "品牌名称"
          },
          "platform": {
            "type": "string",
            "title": "Platform",
            "description": "平台名称"
          },
          "mention_rate": {
            "type": "number",
            "title": "Mention Rate",
            "description": "品牌总提及率"
          },
          "first_mention_rate": {
            "type": "number",
            "title": "First Mention Rate",
            "description": "首次提及品牌率"
          },
          "citation_rate_by_post": {
            "type": "number",
            "title": "Citation Rate By Post",
            "description": "引用率"
          },
          "prompt_count": {
            "type": "integer",
            "title": "Prompt Count",
            "description": "问题总数"
          },
          "citation_source_count": {
            "type": "integer",
            "title": "Citation Source Count",
            "description": "引用来源数量"
          },
          "keyword_coverage": {
            "type": "integer",
            "title": "Keyword Coverage",
            "description": "关键词覆盖数"
