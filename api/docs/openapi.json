  "components": {
    "schemas": {
      "AnalysisRequest": {
        "properties": {
          "brand_name": {
            "type": "string",
            "title": "Brand Name",
            "description": "品牌名称"
          },
          "analysis_type": {
            "$ref": "#/components/schemas/AnalysisType",
            "description": "分析类型"
          },
          "params": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Params",
            "description": "分析参数"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider",
            "description": "LLM提供商",
            "default": "openai"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model",
            "description": "模型名称",
            "default": "gpt-3.5-turbo"
          }
        },
        "type": "object",
        "required": [
          "brand_name",
          "analysis_type"
        ],
        "title": "AnalysisRequest",
        "description": "分析请求模型."
      },
      "AnalysisResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "是否成功"
          },
          "data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data",
            "description": "响应数据"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "响应消息"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp",
            "description": "时间戳"
          }
        },
        "type": "object",
        "required": [
          "success",
          "message",
          "timestamp"
        ],
        "title": "AnalysisResponse",
        "description": "分析响应模型."
      },
      "AnalysisType": {
        "type": "string",
        "enum": [
          "brand_recognition",
          "sentiment_analysis",
          "competitive_analysis",
          "mention_analysis"
        ],
        "title": "AnalysisType",
        "description": "分析类型枚举."
      },
      "BrandMentionRateData": {
        "properties": {
          "mention_rate": {
            "type": "number",
            "title": "Mention Rate",
            "description": "品牌总提及率(百分比)"
          },
          "rank": {
            "type": "integer",
            "title": "Rank",
            "description": "品牌排名"
          },
          "change": {
            "type": "number",
            "title": "Change",
            "description": "与上一周期对比的变化(百分比)"
          },
          "question_count": {
            "type": "integer",
            "title": "Question Count",
            "description": "问题总数"
          },
          "mention_count": {
            "type": "integer",
            "title": "Mention Count",
            "description": "品牌提及数量"
          },
          "first_mention_count": {
            "type": "integer",
            "title": "First Mention Count",
            "description": "首次提及品牌数量"
          },
          "analysis_date": {
            "type": "string",
            "title": "Analysis Date",
            "description": "分析日期"
          },
          "last_updated": {
            "type": "string",
            "format": "date-time",
            "title": "Last Updated",
            "description": "最后更新时间"
          }
        },
        "type": "object",
        "required": [
          "mention_rate",
          "rank",
          "change",
          "question_count",
          "mention_count",
          "first_mention_count",
          "analysis_date",
          "last_updated"
        ],
        "title": "BrandMentionRateData",
        "description": "品牌总提及率数据模型."
      },
      "BrandMentionRateResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "响应状态"
          },
          "data": {
            "$ref": "#/components/schemas/BrandMentionRateData",
            "description": "品牌总提及率数据"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "元数据"
          }
        },
        "type": "object",
        "required": [
          "status",
          "data",
          "metadata"
        ],
        "title": "BrandMentionRateResponse",
        "description": "品牌总提及率响应模型."
      },
