        "type": "object",
        "required": [
          "brand",
          "platform",
          "mention_rate",
          "first_mention_rate",
          "citation_rate_by_post",
          "prompt_count",
          "citation_source_count",
          "keyword_coverage"
        ],
        "title": "BrandMetricsItem"
