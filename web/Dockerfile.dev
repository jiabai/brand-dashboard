FROM node:24.13.0-slim

WORKDIR /app

COPY package*.json ./
RUN npm install --ignore-scripts

COPY . .

EXPOSE 3000

CMD ["sh", "-lc", "if [ ! -f node_modules/.package-lock.json ] || ! cmp -s package-lock.json node_modules/.package-lock.json; then npm ci --ignore-scripts; fi; npm run dev -- --host 0.0.0.0 --port 3000"]
