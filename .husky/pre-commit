set -euo pipefail

DOC_DIRS="docs/design-docs docs/product-specs docs/exec-plans/completed docs/references"

STAGED_DOC_FILES=""
for dir in $DOC_DIRS; do
  dir_files=$(git diff --cached --name-only --relative "$dir" 2>/dev/null || true)
  if [ -n "$dir_files" ]; then
    STAGED_DOC_FILES="$STAGED_DOC_FILES $dir_files"
  fi
done
STAGED_DOC_FILES=$(echo "$STAGED_DOC_FILES" | xargs -n1 | sort -u)

if [ -z "$STAGED_DOC_FILES" ]; then
  echo "\n[pre-commit] Missing updated record in docs/ subdirectories (design-docs, product-specs, exec-plans/completed, references)." >&2
  exit 1
fi

for dir in $DOC_DIRS; do
  if [ -n "$(git diff --name-only "$dir" 2>/dev/null || true)" ]; then
    echo "\n[pre-commit] Unstaged changes detected in $dir. Stage them before committing." >&2
    exit 1
  fi
done

for file in $STAGED_DOC_FILES; do
  case "$file" in
    docs/*)
      if ! printf '%s' "$file" | grep -Eq 'docs/(design-docs|product-specs|exec-plans/completed|references)/[0-9]{8}-[0-9]{6}-[a-z0-9-]+\.md$'; then
        echo "\n[pre-commit] Invalid file name or location: $file" >&2
        echo "Expected: docs/{design-docs,product-specs,exec-plans/completed,references}/YYYYMMDD-HHMMSS-topic.md" >&2
        exit 1
      fi
      if ! grep -q '^## Summary' "$file"; then
        echo "\n[pre-commit] Missing \"## Summary\" section in $file" >&2
        exit 1
      fi
      if ! grep -q '^## Code Highlights' "$file"; then
        echo "\n[pre-commit] Missing \"## Code Highlights\" section in $file" >&2
        exit 1
      fi
      if ! grep -q '^## Self-Tests' "$file"; then
        echo "\n[pre-commit] Missing \"## Self-Tests\" section in $file" >&2
        exit 1
      fi
      ;;
  esac
done

# Backend lint
if command -v ruff >/dev/null 2>&1; then
  (cd api && ruff check .)
else
  echo "[backend] Ruff is not installed. Install via \"pip install -r api/requirements-dev.txt\"." >&2
  exit 1
fi

# Run available frontend quality checks if configured
if command -v npm >/dev/null 2>&1; then
  npm --prefix web run lint --if-present
  npm --prefix web test --if-present
fi
